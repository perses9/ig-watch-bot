# --- required ---------------------------------------------------------------
BOT_TOKEN=your-telegram-bot-token-from-botfather

# Your Telegram chat ID. Send /myid to the bot to get it. Without this (and
# without ALLOWED_CHAT_IDS) anyone who finds the bot can use it. The owner is
# the only one who can grant or revoke access.
OWNER_CHAT_ID=

# --- storage ----------------------------------------------------------------
# On a container host this MUST point at a mounted volume, e.g.
# /data/watchlist.db. Anywhere else, the database is destroyed on every deploy,
# taking every tracked account with it. Left unset, a mounted /data is used
# automatically when one exists.
DB_PATH=

# --- proxy ------------------------------------------------------------------
# Residential proxy, e.g. http://user:pass@geo.iproyal.com:12321
# Effectively required: Instagram blocks datacenter IP ranges (Railway, any
# VPS) regardless of how browser-like the requests look. Prefer a per-request
# rotating plan over sticky sessions.
PROXY_URL=

# Try one unproxied request when the proxy is unreachable. Usually fails, but
# beats going completely blind when the provider runs out of data. Set to 0 to
# keep every request on the proxy.
ALLOW_DIRECT_FALLBACK=1

# --- timing and cost --------------------------------------------------------
# How often accounts that are DOWN get rechecked. Most of a watchlist is
# usually down, so this drives nearly all the request volume and most of the
# bill. 60 is possible but rarely worth it - you're waiting on a reinstatement
# that takes days, so 5 minutes late is not late.
CHECK_INTERVAL_SECONDS=300

# How often accounts that are already LIVE get rechecked. Much slower on
# purpose - a live account returns a full profile (~15x the data), so this is
# where the proxy bill comes from. Default is 6 hours. Raise it to cut costs
# further; lower it only if you need to hear quickly about a live account
# going DOWN (the reverse direction is already fast).
LIVE_CHECK_SECONDS=21600

# What your proxy provider charges per GB. Only used to put a dollar figure on
# the projection in /uptime. Use the rate on the tier you actually buy, not the
# advertised one - IPRoyal headlines $1.75/GB but small orders are $6-7/GB.
PROXY_COST_PER_GB=6.00

# Agreeing checks required before a status change is announced. Stops one
# flaky response firing a false "back online" alert.
CONFIRM_CHECKS=2

# API retries before falling back. The API answers from some exit IPs and
# refuses on others, and every request uses a different IP, so retrying is a
# fresh chance rather than a repeat. Each response is a few hundred bytes, so
# six attempts still cost a fraction of one page fetch.
API_ATTEMPTS=6

# Page fetches after the API gives up. Kept low: the page is ~600KB and often
# contains no profile data at all.
CHECK_ATTEMPTS=1

# --- access -----------------------------------------------------------------
# Static allowlist, comma-separated, additive to people invited from chat.
# If OWNER_CHAT_ID is unset, the FIRST entry here becomes the owner.
ALLOWED_CHAT_IDS=

# How many people the owner can invite, not counting themselves.
MAX_GUEST_USERS=5
