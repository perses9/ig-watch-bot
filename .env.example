BOT_TOKEN=your-telegram-bot-token-from-botfather
# 15s is fine for 1-2 watched accounts on a VPS; raise it if logs show
# frequent rate_limited/temporary check issues once you add more accounts.
CHECK_INTERVAL_SECONDS=15
CONFIRM_CHECKS=2
DB_PATH=watchlist.db
# Comma-separated Telegram chat IDs allowed to use the bot (your own chat ID).
# Leave empty to allow anyone who finds the bot to use it - not recommended
# now that the repo (and therefore the bot's existence) is public.
ALLOWED_CHAT_IDS=
