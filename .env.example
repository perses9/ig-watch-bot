BOT_TOKEN=your-telegram-bot-token-from-botfather
# 15s is fine for 1-2 watched accounts on a VPS; raise it if logs show
# frequent rate_limited/temporary check issues once you add more accounts.
CHECK_INTERVAL_SECONDS=15
CONFIRM_CHECKS=2
DB_PATH=watchlist.db
# Comma-separated Telegram chat IDs allowed to use the bot (your own chat ID).
# Leave empty to allow anyone who finds the bot to use it - not recommended
# now that the repo (and therefore the bot's existence) is public.
ALLOWED_CHAT_IDS=
# The owner can grant/revoke access from inside Telegram (/adduser, /users).
# If unset, the lowest ALLOWED_CHAT_IDS entry becomes the owner.
OWNER_CHAT_ID=
# How many other people the owner can grant access to.
MAX_GUEST_USERS=5
# Residential/mobile proxy URL from a provider (Bright Data, Oxylabs,
# Smartproxy, IPRoyal, etc), e.g. http://user:pass@gate.provider.com:8000
# Leave empty to make requests directly from this server's own IP - fine
# until Instagram starts blocking that IP, which datacenter hosts (Railway,
# any VPS) are prone to regardless of how browser-like the requests look.
PROXY_URL=
